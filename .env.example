# ---------------------------------------------------------------- wallet
# 32-byte hex, 0x-prefixed. Burner wallet only.
PRIVATE_KEY=""

# ------------------------------------------------------------ explorers
# Optional. Free tier. One key covers every chain via Etherscan V2.
API_KEY=""

# ---------------------------------------------------------------- RPCs
# Optional. Blank means the built-in public endpoints are used.
RPC_ETHEREUM=""
RPC_BSC=""
RPC_POLYGON=""
RPC_ARBITRUM=""
RPC_BASE=""
RPC_OPTIMISM=""
RPC_AVALANCHE=""
RPC_FANTOM=""

# ------------------------------------------------------------- plan scope
PLAN_CHAINS="arbitrum,base"
PLAN_AGE="1-6"
MIN_TVL="0.05"
MIN_PROFIT="0.0004"
MAX_TARGETS="40"

# ----------------------------------------------------------- live gates
# Default is OFF. Nothing fires until these are set.
AUTHORIZED="no"
AUTH_FILE="AUTHORIZATION.md"
NETWORK=""                 # testnet | fork | mainnet
CONFIRM_LIVE=""

# Single target. Live mode never discovers.
LIVE_CHAIN=""
LIVE_TARGET=""
MAX_TXS="1"

# Only needed when NETWORK=mainnet
MAINNET_ACK=""
TARGET_ALLOWLIST=""

# Only needed for ./ops/runbook.sh live-auto, fork or testnet only
LIVE_AUTO="no"
ALLOW_AUTOMATION="no"
